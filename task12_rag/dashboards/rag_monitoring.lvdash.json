    },
    {
     "widget": {
      "name": "b_retrieval",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "eval_latest",
         "fields": [
          {
           "name": "chunk_profile",
           "expression": "`chunk_profile`"
          },
          {
           "name": "hit",
           "expression": "AVG(CASE WHEN `in_scope` AND `mode` = 'rag' THEN `hit` END)"
          },
          {
           "name": "abstained",
           "expression": "AVG(CASE WHEN NOT `in_scope` THEN `abstained` END)"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 3,
       "widgetType": "bar",
