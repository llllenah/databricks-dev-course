{
 "datasets": [
  {
   "name": "eval_latest",
   "displayName": "eval_latest",
   "queryLines": [
    "SELECT mode, coalesce(chunk_profile, 'none') AS chunk_profile, concat(mode, ' / ', coalesce(chunk_profile, 'no context')) AS variant, in_scope, question_id, hit_rank,\n",
    "       CAST(hit_rank IS NOT NULL AS INT) AS hit, correct, relevant, grounded, CAST(abstained AS INT) AS abstained,\n",
    "       latency_ms, prompt_tokens + completion_tokens AS tokens\n",
    "FROM eval_results\n",
    "WHERE run_id = (SELECT max_by(run_id, evaluated_at) FROM eval_results)\n"
   ]
  },
  {
   "name": "requests",
   "displayName": "requests",
   "queryLines": [
    "SELECT logged_at, date_trunc('HOUR', logged_at) AS hour, source, mode, chunk_profile, user_name, question,\n",
    "       answer, abstained, latency_ms, prompt_tokens, completion_tokens, retrieved_docs, cited_docs\n",
    "FROM qa_log\n"
   ]
  }
 ],
 "pages": [
  {
   "name": "rag",
   "displayName": "RAG monitoring",
   "layout": [
    {
     "widget": {
      "name": "c_requests",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "requests",
         "fields": [
          {
           "name": "v_c_requests",
           "expression": "COUNT(`logged_at`)"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "counter",
       "encodings": {
        "value": {
         "fieldName": "v_c_requests",
         "displayName": "Logged answers (all sources)"
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Logged answers (all sources)"
       }
      }
     },
     "position": {
      "x": 0,
      "y": 0,
      "width": 2,
      "height": 3
     }
    },
    {
     "widget": {
      "name": "c_latency",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "requests",
         "fields": [
          {
           "name": "v_c_latency",
           "expression": "AVG(`latency_ms`)"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "counter",
       "encodings": {
        "value": {
         "fieldName": "v_c_latency",
         "displayName": "Avg latency, ms"
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Avg latency, ms"
       }
      }
     },
     "position": {
      "x": 2,
      "y": 0,
      "width": 2,
      "height": 3
     }
    },
    {
     "widget": {
      "name": "c_tokens",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "requests",
         "fields": [
          {
           "name": "v_c_tokens",
           "expression": "SUM(`prompt_tokens` + `completion_tokens`)"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "counter",
       "encodings": {
        "value": {
         "fieldName": "v_c_tokens",
         "displayName": "Tokens used"
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Tokens used"
       }
      }
     },
     "position": {
      "x": 4,
      "y": 0,
      "width": 2,
      "height": 3
     }
    },
    {
     "widget": {
      "name": "b_quality",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "eval_latest",
         "fields": [
          {
           "name": "variant",
           "expression": "`variant`"
          },
          {
           "name": "correct",
           "expression": "AVG(CASE WHEN `in_scope` THEN `correct` END)"
          },
          {
           "name": "grounded",
           "expression": "AVG(CASE WHEN `in_scope` THEN `grounded` END)"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 3,
       "widgetType": "bar",
       "encodings": {
        "x": {
         "fieldName": "variant",
         "scale": {
          "type": "categorical"
         },
         "displayName": "variant"
        },
        "y": {
         "scale": {
          "type": "quantitative"
         },
         "fields": [
          {
           "fieldName": "correct",
           "displayName": "Correct (in scope)"
          },
          {
           "fieldName": "grounded",
           "displayName": "Grounded (in scope)"
          }
         ]
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Latest evaluation: with vs without retrieval"
