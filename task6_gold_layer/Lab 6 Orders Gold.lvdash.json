{
  "datasets": [
    {
      "name": "kpi_sales",
      "displayName": "kpi_sales",
      "queryLines": [
        "SELECT d.date, f.segment, c.customer_name, f.order_id, f.amount\n",
        "FROM dbr_dev_ua_5816_trail.lena066636_gold.fact_orders f\n",
        "JOIN dbr_dev_ua_5816_trail.lena066636_gold.dim_date d ON f.date_key = d.date_key\n",
        "JOIN dbr_dev_ua_5816_trail.lena066636_gold.dim_customer c ON f.customer_key = c.customer_key"
      ]
    },
    {
      "name": "revenue_by_hour",
      "displayName": "revenue_by_hour",
      "queryLines": [
        "SELECT timestampadd(HOUR, t.hour_of_day, CAST(d.date AS TIMESTAMP)) AS hour,\n",
        "       t.day_part, f.segment, count(*) AS orders, round(sum(f.amount), 2) AS revenue\n",
        "FROM dbr_dev_ua_5816_trail.lena066636_gold.fact_orders f\n",
        "JOIN dbr_dev_ua_5816_trail.lena066636_gold.dim_date d ON f.date_key = d.date_key\n",
        "JOIN dbr_dev_ua_5816_trail.lena066636_gold.dim_time t ON f.time_key = t.time_key\n",
        "GROUP BY 1, 2, 3"
      ]
    },
    {
      "name": "top_customers",
      "displayName": "top_customers",
      "queryLines": [
        "SELECT c.customer_name, g.segment, g.orders, g.revenue, g.avg_order_value\n",
        "FROM dbr_dev_ua_5816_trail.lena066636_gold.agg_customer_sales g\n",
        "JOIN dbr_dev_ua_5816_trail.lena066636_gold.dim_customer c ON g.customer_key = c.customer_key\n",
        "ORDER BY g.revenue DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "revenue_by_segment",
      "displayName": "revenue_by_segment",
      "queryLines": [
        "SELECT d.date, f.segment, count(*) AS orders, round(sum(f.amount), 2) AS revenue\n",
        "FROM dbr_dev_ua_5816_trail.lena066636_gold.fact_orders f\n",
        "JOIN dbr_dev_ua_5816_trail.lena066636_gold.dim_date d ON f.date_key = d.date_key\n",
        "GROUP BY d.date, f.segment"
      ]
    },
    {
      "name": "order_amount_distribution",
      "displayName": "order_amount_distribution",
      "queryLines": [
        "SELECT d.date, f.segment,\n",
        "       CASE WHEN f.amount < 50 THEN '1) under 50'\n",
        "            WHEN f.amount < 100 THEN '2) 50-100'\n",
        "            WHEN f.amount < 150 THEN '3) 100-150'\n",
        "            ELSE '4) 150+' END AS amount_bucket,\n",
        "       count(*) AS orders\n",
        "FROM dbr_dev_ua_5816_trail.lena066636_gold.fact_orders f\n",
        "JOIN dbr_dev_ua_5816_trail.lena066636_gold.dim_date d ON f.date_key = d.date_key\n",
        "GROUP BY 1, 2, 3"
      ]
    },
    {
      "name": "revenue_by_day_part",
      "displayName": "revenue_by_day_part",
      "queryLines": [
        "SELECT d.date, t.day_part, f.segment, count(*) AS orders, round(sum(f.amount), 2) AS revenue\n",
        "FROM dbr_dev_ua_5816_trail.lena066636_gold.fact_orders f\n",
        "JOIN dbr_dev_ua_5816_trail.lena066636_gold.dim_date d ON f.date_key = d.date_key\n",
        "JOIN dbr_dev_ua_5816_trail.lena066636_gold.dim_time t ON f.time_key = t.time_key\n",
        "GROUP BY d.date, t.day_part, f.segment"
      ]
    }
  ],
